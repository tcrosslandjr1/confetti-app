# ============================================================
# Confetti Fetcher — Environment Variables
# Copy this to .env and fill in your real keys
# NEVER commit .env to GitHub
# ============================================================

# Bright Data (TikTok + Web Search)
# Get key at: https://brightdata.com → Account Settings → API Token
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
BRIGHTDATA_ZONE=datacenter

# Google Places API
# Enable "Places API (New)" at: https://console.cloud.google.com
GOOGLE_PLACES_KEY=your_google_places_key_here

# Yelp Fusion API
# Create app at: https://fusion.yelp.com
YELP_API_KEY=your_yelp_api_key_here

# Supabase — USE SERVICE ROLE KEY (not anon key!)
# Get from: Supabase Dashboard → Settings → API → service_role
SUPABASE_URL=https://zfeckvxkulreyapadanf.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# NAS paths (adjust if your NAS folder structure differs)
EXCEL_PATH=/volume1/homes/admin/confetti_fetcher/confetti_venues.xlsx
LOG_PATH=/volume1/homes/admin/confetti_fetcher/fetch_log.txt
